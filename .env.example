APP_NAME=Fintel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://fintel:fintel@localhost:5432/fintel
POSTGRES_PASSWORD=fintel

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

SEC_USER_AGENT=Fintel your-email@example.com
SEC_BASE_URL=https://www.sec.gov
SEC_DATA_BASE_URL=https://data.sec.gov

DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=data
S3_BUCKET_NAME=
S3_KEY_PREFIX=raw
S3_ENDPOINT_URL=
S3_REGION_NAME=

EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu

REDIS_URL=redis://localhost:6379/0
INGESTION_QUEUE_NAME=fintel:ingestion_jobs

LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
